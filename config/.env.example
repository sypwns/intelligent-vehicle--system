
# Backend configuration example
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/smartcar

# External services
WEATHER_API_KEY=YOUR_WEATHER_API_KEY
ROUTING_API_KEY=YOUR_ROUTING_API_KEY

# Vehicle integration
VEHICLE_API_CLIENT_ID=YOUR_CLIENT_ID
VEHICLE_API_CLIENT_SECRET=YOUR_CLIENT_SECRET
